# =============================================================================
# QUANTA — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in all required values.
#   cp .env.example .env
#
# NEVER commit .env to git. The .gitignore already excludes it.
# For production, use a secrets manager (AWS Secrets Manager, Doppler, Vault).
# =============================================================================

# --- GLOBAL ---
ENVIRONMENT=development
GIN_MODE=debug
LOG_LEVEL=debug

# --- AUTHENTICATION: Skip only for local dev. MUST be false in any public env ---
# Set to 'true' ONLY in your local .env, never in docker-compose.yml directly.
SKIP_AUTH=true
DEV_USER_ID=<your_clerk_user_id_here>

# --- CLERK (Production Auth) ---
CLERK_SECRET_KEY=sk_test_<...>
CLERK_PUBLISHABLE_KEY=pk_test_<...>

# --- DATABASE ---
# Local Docker (used by docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quanta
# Production (Supabase example):
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true

# --- SECURITY ---
# AES-256-GCM master key — MUST be exactly 32 bytes.
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=<generate_32_byte_hex_here>

# Fernet key for execution-plane account_pool password encryption.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<generate_fernet_key_here>

# Webhook HMAC signing secret (any random string, min 32 chars)
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=<generate_random_hex_here>

# --- AI PROVIDERS ---
# Primary LLM provider: 'nvidia' or 'gemini'
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-<your_nvidia_api_key_here>

# Navigation model (Phase 1)
LLM_MODEL=meta/llama-3.1-8b-instruct

# Extraction model (Phase 2 — LLM fallback only, DOM extractor is primary)
LLM_EXTRACTION_MODEL=meta/llama-3.1-8b-instruct

# Token budget per job (navigation + extraction combined)
LLM_TOKEN_BUDGET=40000

# --- FALLBACK LLM PROVIDER (optional but highly recommended) ---
# When primary provider fails all retries, this provider is tried once.
# Set to 'gemini' to use Google Gemini as fallback.
LLM_FALLBACK_PROVIDER=gemini
GOOGLE_API_KEY=AIza<your_google_api_key_here>

# --- REDIS ---
REDIS_URL=redis://localhost:6379/0

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- TEMPORAL ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# --- MINIO / S3 (Local) ---
ENABLE_S3_UPLOAD=true
S3_BUCKET=quanta-local-bucket
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# --- BILLING (Polar.sh) ---
POLAR_ACCESS_TOKEN=polar_at_<...>
POLAR_WEBHOOK_SECRET=polar_whsec_<...>

# --- PROXY (optional — required for WAF bypass) ---
# Format: http://user:password@host:port
PROXY_SERVER=
PROXY_USER=
PROXY_PASSWORD=

# --- FEATURE FLAGS ---
ENABLE_BILLING=true
ENABLE_NOTIFICATIONS=true
ENABLE_TRACING=false
ENABLE_METRICS=true

# --- TIMEOUTS (seconds) ---
TIMEOUT_ACTIVITY_SEC=300
TIMEOUT_LLM_SEC=40
TIMEOUT_HTTP_REQUEST_SEC=30
TIMEOUT_NAVIGATION_MS=30000
TIMEOUT_CLICK_MS=10000

# --- RATE LIMITS ---
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
DEFAULT_CREDITS=10

# --- DEV FLAGS ---
ALLOW_LOCAL_TARGETS=false
QUANTA_HEADLESS=true
