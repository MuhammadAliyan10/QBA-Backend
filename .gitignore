# =======================================================
# 🐍 PYTHON (Execution Plane)
# =======================================================
venv/
.venv/
*.py[cod]
*$py.class
.coverage
*.egg-info

# Playwright / Browsers (These are massive!)
/tmp/test_*.png
/tmp/test_*.mp4

# =======================================================
# 🐹 GO (Control Plane)
# =======================================================
*.exe
*.test
*.out

# Specific Binary Names (Linux/Mac don't use .exe)
main
server
control-plane
app
execution-plane

# =======================================================
# ⚛️ NODE / NEXT.JS (Frontend)
# =======================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =======================================================
# 🏗️ TERRAFORM (Infra) - CRITICAL SECURITY
# =======================================================
# .tfstate contains your DB passwords in plain text!
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude sensitive variables
*.tfvars
*.tfvars.json

# Ignore the .terraform folder (plugins)
.terraform/
.terraform.lock.hcl

# =======================================================
# 🐳 DOCKER & LOCAL DEV
# =======================================================
docker-compose.override.yml

# =======================================================
# 🔐 SECRETS & ENV
# =======================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# =======================================================
# 🖥️ IDE / EDITOR
# =======================================================
*.swp
*.swo
.DS_Store
*.log
*.iml

# =======================================================
# 📂 PROJECT SPECIFIC
# =======================================================
*.db
*.sqlite3
patterns.db
security-report.json
infra/terraform.tfvars

