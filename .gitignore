# =======================================================
# 🐍 PYTHON (Execution Plane)
# =======================================================
**/venv/
**/.venv/
**/__pycache__/
*.py[cod]
*$py.class
.coverage
*.egg-info

# Playwright / Browsers (These are massive!)
/tmp/test_*.png
/tmp/test_*.mp4

# =======================================================
# 🐹 GO (Control Plane)
# =======================================================
*.exe
*.test
*.out
# Specific Binaries (Targeted to avoid ignoring source folders)
apps/control-plane/control-plane
apps/execution-plane/execution-plane
**/bin/
**/tmp/

# Ignore large artifacts and caches
apps/execution-plane/artifacts/*.json
apps/execution-plane/src/.quanta_cache/

# =======================================================
# ⚛️ NODE / NEXT.JS (Frontend)
# =======================================================
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =======================================================
# 🏗️ TERRAFORM (Infra) - CRITICAL SECURITY
# =======================================================
# .tfstate contains your DB passwords in plain text!
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Exclude sensitive variables
*.tfvars
*.tfvars.json

# Ignore the .terraform folder (plugins)
.terraform/
.terraform.lock.hcl

# =======================================================
# 🐳 DOCKER & LOCAL DEV
# =======================================================
docker-compose.override.yml

# =======================================================
# 🔐 SECRETS & ENV
# =======================================================
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert

# =======================================================
# 🖥️ IDE / EDITOR
# =======================================================
*.swp
*.swo
.DS_Store
*.log
*.iml

# =======================================================
# 📂 PROJECT SPECIFIC
# =======================================================
*.db
*.sqlite3
patterns.db
security-report.json
infra/terraform.tfvars

