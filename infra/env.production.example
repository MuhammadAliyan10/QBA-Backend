# =============================================================================
# QUANTA - Production Environment Variables Template
# =============================================================================
# Copy this file to .env.production and fill in your values:
#   cp env.production.example .env.production
#
# NEVER commit .env.production to git!
# =============================================================================

# =============================================================================
# AZURE INFRASTRUCTURE
# =============================================================================

# Azure Subscription (for Terraform)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Container Registry (from Terraform output)
ACR_LOGIN_SERVER=quantaprodacr.azurecr.io
ACR_USERNAME=quantaprodacr
ACR_PASSWORD=

# =============================================================================
# DATABASE (Supabase)
# =============================================================================

# Supabase PostgreSQL connection string
# Use Transaction Mode (port 6543) for PgBouncer compatibility
DATABASE_URL=postgresql://postgres.[PROJECT-ID]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# =============================================================================
# MESSAGE BROKER (NATS)
# =============================================================================

# Self-hosted or Synadia Cloud
NATS_URL=nats://user:password@nats.example.com:4222

# =============================================================================
# WORKFLOW ORCHESTRATION (Temporal)
# =============================================================================

# Temporal Cloud or self-hosted
TEMPORAL_HOST=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# =============================================================================
# CACHE (Redis/Upstash)
# =============================================================================

# Upstash Redis or self-hosted
REDIS_URL=rediss://default:password@us1-warm-macaw-12345.upstash.io:6379

# =============================================================================
# AUTHENTICATION (Clerk)
# =============================================================================

CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
CLERK_SECRET_KEY=sk_live_xxxxxxxx

# =============================================================================
# PAYMENTS (Polar)
# =============================================================================

POLAR_ACCESS_TOKEN=polar_at_xxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxx

# =============================================================================
# AI / LLM (OpenAI)
# =============================================================================

# --- AI BRAIN ---
# OPENAI_API_KEY=sk-xxxxxxxx
GOOGLE_API_KEY=AIzaSy...
LLM_PROVIDER=gemini

# =============================================================================
# BLOB STORAGE (Cloudflare R2)
# =============================================================================

ENABLE_S3_UPLOAD=true
S3_BUCKET=quanta-production
S3_ENDPOINT_URL=https://xxxxxxxx.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# SECURITY
# =============================================================================

# Session encryption key (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Webhook signing secret (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=

# =============================================================================
# APPLICATION CONFIG
# =============================================================================

# Go Control Plane
GIN_MODE=release
PORT_GO_API=8080

# Python Execution Plane
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_BILLING=true
ENABLE_NOTIFICATIONS=true
ENABLE_TRACING=false
ENABLE_METRICS=true

# =============================================================================
# TIMEOUTS & RETRIES (Centralized Config)
# =============================================================================

# Workflow & Activity Timeouts (Seconds)
TIMEOUT_ACTIVITY_SEC=300
TIMEOUT_HUMAN_WAIT_SEC=86400
TIMEOUT_LLM_SEC=30
TIMEOUT_VECTOR_DB_SEC=5
TIMEOUT_WORKFLOW_START_SEC=30
TIMEOUT_SIGNAL_WORKFLOW_SEC=30
TIMEOUT_HTTP_REQUEST_SEC=30
TIMEOUT_WS_PING_SEC=30
TIMEOUT_GRACEFUL_SHUTDOWN_SEC=15

# Browser Automation Timeouts (Milliseconds)
TIMEOUT_CLICK_MS=5000
TIMEOUT_NAVIGATION_MS=30000

# Retry Logic
MAX_RETRY_ATTEMPTS=3
INITIAL_RETRY_INTERVAL_SEC=2
RETRY_BACKOFF_COEFFICIENT=2.0

# =============================================================================
# RATE LIMITING & BILLING
# =============================================================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
CREDIT_PER_JOB=10
DEFAULT_CREDITS=100

# =============================================================================
# NOTIFICATIONS (Optional - Uncomment if ENABLE_NOTIFICATIONS=true)
# =============================================================================

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# SendGrid
# SENDGRID_API_KEY=

# Slack
# SLACK_WEBHOOK_URL=

# =============================================================================
# PROXY CONFIGURATION (Optional)
# =============================================================================
# PROXY_SERVER=http://brd.superproxy.io:22225
# PROXY_USER=
# PROXY_PASSWORD=
