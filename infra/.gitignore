# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform lock file (can be committed, but often ignored)
.terraform.lock.hcl

# Terraform directory

# Sensitive variable files
*.tfvars
!terraform.tfvars.example

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan output files
*.tfplan
plan.out
