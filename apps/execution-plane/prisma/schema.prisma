// =============================================================================
// QUANTA - Enterprise Automation Platform
// Database Schema (PostgreSQL on Supabase)
// =============================================================================
//
// Stack: PostgreSQL + Prisma ORM + Clerk Auth + Azure Blob Storage
// Security: Clerk handles auth (no passwords stored). Vault values are AES-256.
//
// Domains:
// 1. Identity & Usage (UserProfile, UserUsage, CreditTransaction)
// 2. Vault (VaultSecret)
// 3. Workflow Engine (Workflow, Job, JobLog)
// 4. Storage (StorageAsset)
//
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserTier {
  FREE
  PRO
  ENTERPRISE

  @@map("user_tier")
}

enum TransactionType {
  CREDIT     // Credits added (purchase, bonus)
  DEBIT      // Credits spent (job execution)
  REFUND     // Credits returned (failed job)
  ADJUSTMENT // Manual admin adjustment

  @@map("transaction_type")
}

enum JobStatus {
  QUEUED     // Waiting in queue to run
  RUNNING    // Currently executing
  PAUSED     // User paused mid-execution
  COMPLETED  // Successfully finished
  FAILED     // Encountered error
  CANCELLED  // User cancelled

  @@map("job_status")
}

enum TriggerType {
  ON_DEMAND  // Manual trigger
  SCHEDULED  // Cron-based
  WEBHOOK    // External trigger

  @@map("trigger_type")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR

  @@map("log_level")
}

enum AssetType {
  OUTPUT     // Generated by job (PDF, CSV, screenshot)
  INPUT      // User uploaded for workflow use
  CHECKPOINT // Snapshot for resumability

  @@map("asset_type")
}

// =============================================================================
// DOMAIN 1: IDENTITY & USAGE
// =============================================================================

/// User profile linked to Clerk authentication
/// We trust clerk_user_id as the source of truth - no passwords stored
model UserProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  email       String   @unique
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  avatarUrl   String?  @map("avatar_url")
  tier        UserTier @default(FREE)

  // Webhook configuration
  webhookUrl    String? @map("webhook_url")
  webhookSecret String? @map("webhook_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  usage        UserUsage?
  transactions CreditTransaction[]
  secrets      VaultSecret[]
  workflows    Workflow[]
  jobs         Job[]
  assets       StorageAsset[]
  apiKeys      ApiKey[]

  @@index([clerkUserId])
  @@index([email])
  @@map("user_profiles")
}

/// User credit balance and usage tracking
/// This is the "wallet" - tracks current balance
model UserUsage {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String @unique @map("user_id") @db.Uuid
  creditsBalance Int    @default(0) @map("credits_balance")

  // Usage metrics (updated after each job)
  totalJobsRun   Int @default(0) @map("total_jobs_run")
  totalCreditsUsed Int @default(0) @map("total_credits_used")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_usage")
}

/// Credit transaction ledger - ACID compliant history
/// Never just decrement balance; always create a transaction record
model CreditTransaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  amount      Int             // Positive for credit, negative for debit
  balanceAfter Int            @map("balance_after") // Snapshot of balance after this transaction

  // Context
  description String
  jobId       String?         @map("job_id") @db.Uuid // If related to a job
  metadata    Json?           // Additional context (Stripe session, etc.)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([jobId])
  @@map("credit_transactions")
}

/// API Keys for programmatic access
model ApiKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   // User-friendly name
  keyPrefix String   @map("key_prefix") // e.g., "sk_live_abc..."
  keyHash   String   @map("key_hash") // SHA-256 hash of full key

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// =============================================================================
// DOMAIN 2: VAULT (SECRETS MANAGEMENT)
// =============================================================================

/// Encrypted secrets storage
/// SECURITY: The `encryptedValue` field contains AES-256-GCM encrypted data
/// The encryption key is derived from user's master key + secret-specific salt
model VaultSecret {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  keyName        String  @map("key_name") // e.g., "OPENAI_API_KEY"

  // SECURITY: This is AES-256-GCM encrypted, NOT plain text
  // Format: base64(iv + ciphertext + authTag)
  encryptedValue String  @map("encrypted_value")

  // Security metadata
  requiresPin    Boolean @default(false) @map("requires_pin")
  pinHash        String? @map("pin_hash") // SHA-256 hash of PIN if required

  // Audit
  lastAccessedAt DateTime? @map("last_accessed_at")
  accessCount    Int       @default(0) @map("access_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyName])
  @@index([userId])
  @@map("vault_secrets")
}

// =============================================================================
// DOMAIN 3: WORKFLOW ENGINE
// =============================================================================

/// Saved automation workflow
/// The `recipeJson` contains the DAG (nodes, edges, step configurations)
model Workflow {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  name        String
  description String?

  // Trigger configuration
  triggerType  TriggerType @default(ON_DEMAND) @map("trigger_type")
  cronSchedule String?     @map("cron_schedule") // Cron expression if scheduled

  // The DAG structure (nodes, edges, step configs)
  // This is the core recipe that defines what the bot does
  recipeJson Json @map("recipe_json")

  // State
  isActive Boolean @default(true) @map("is_active")

  // Stats
  lastRunAt DateTime? @map("last_run_at")
  runCount  Int       @default(0) @map("run_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([userId])
  @@index([isActive])
  @@index([triggerType])
  @@map("workflows")
}

/// Single execution of a workflow
/// Contains state for checkpointing and resumability
model Job {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  workflowId String    @map("workflow_id") @db.Uuid
  status     JobStatus @default(QUEUED)

  // Timing
  scheduledAt DateTime? @map("scheduled_at") // When it was scheduled to run
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  // Checkpointing for resumability
  // Stores current step, variables, and execution state
  currentStep  Int?   @map("current_step")
  currentState Json?  @map("current_state")

  // Cost tracking
  creditsUsed Int @default(0) @map("credits_used")

  // Error handling
  errorMessage String? @map("error_message")
  errorStack   String? @map("error_stack")
  retryCount   Int     @default(0) @map("retry_count")

  // Result
  resultJson   Json?   @map("result_json")
  resultUrl    String? @map("result_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow     Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs         JobLog[]
  transactions CreditTransaction[]
  assets       StorageAsset[]

  @@index([userId])
  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@map("jobs")
}

/// High-volume execution logs for a job
/// Append-only table optimized for write performance
model JobLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  level     LogLevel @default(INFO)

  // Log content
  message   String
  nodeId    String?  @map("node_id") // Which workflow node generated this
  stepIndex Int?     @map("step_index")

  // Performance data
  durationMs Int? @map("duration_ms")

  // Additional context
  metadata Json?

  timestamp DateTime @default(now())

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([timestamp])
  @@index([level])
  @@map("job_logs")
}

// =============================================================================
// DOMAIN 4: STORAGE (FILE SYSTEM)
// =============================================================================

/// Pointers to files in Azure Blob Storage
/// We store metadata here, binary content lives in Azure
model StorageAsset {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  jobId    String?   @map("job_id") @db.Uuid // Null if user-uploaded
  type     AssetType

  // File metadata
  filename     String
  friendlyName String? @map("friendly_name")
  mimeType     String  @map("mime_type")
  sizeBytes    Int     @map("size_bytes")

  // Azure Blob Storage reference
  // Format: https://<account>.blob.core.windows.net/<container>/<blob>
  azureBlobUrl String @map("azure_blob_url")
  azureBlobId  String @map("azure_blob_id") // Container/blob path for deletion

  // Security
  isPublic  Boolean @default(false) @map("is_public")
  expiresAt DateTime? @map("expires_at") // Auto-delete after this time

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
  @@index([type])
  @@index([createdAt])
  @@map("storage_assets")
}
